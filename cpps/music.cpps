auto main() {
    // 精简的输出提示
    out("命令: <平台> <搜索词>(wy/qq/kg/kw)\n");
    out("示例: wy 万能青年旅店\n");
    out("请输入命令");

    string cmd = "";
    in(cmd);
    
    if (cmd == "") {
        out("\n❌ 未输入命令。\n");
        return;
    }
    
    string kw = "";
    string part = "";
    in(part);
    while (part != "") {
        if (kw == "") kw = part;
        else kw = kw + " " + part;
        
        part = "__EOF__";
        in(part);
        if (part == "__EOF__") break;
    }
    
    if (kw == "") {
        out("\n❌ 未提供搜索词。\n");
        return;
    }

    string encoded_kw = urlencode(kw);
    string browser_ua = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36";
    out("\n========================================\n");

    // ================== 网易云 (wy) ==================
    if (cmd == "wy") {
        out("[1/2] 正在搜索网易云: " + kw + " ...\n");
        string id = "";
        string song_name = "";
        string artist = "";
        string res = "";

        // 源 1：vkeys
        try {
            res = get("https://api.vkeys.cn/v2/music/netease?word=" + encoded_kw) with worker with header {
                "User-Agent": browser_ua
            };
            id = regex(res, "\"id\"\\s*:\\s*([0-9]+)");
            if (id == "") id = regex(res, "\"id\"\\s*:\\s*\"([0-9]+)\"");
            song_name = regex(res, "\"song\"\\s*:\\s*\"([^\"]+)\"");
            artist = regex(res, "\"singer\"\\s*:\\s*\"([^\"]+)\"");
        } catch (e) {}

        // 源 2：GD Studio
        if (id == "") {
            try {
                res = get("https://music-api.gdstudio.xyz/api.php?types=search&source=netease&name=" + encoded_kw + "&count=1&pages=1") with worker;
                id = regex(res, "\"id\":\"([a-zA-Z0-9]+)\"");
                if (id == "") id = regex(res, "\"id\":([0-9]+)");
                song_name = regex(res, "\"name\":\"([^\"]+)\"");
                artist = regex(res, "\"artist\":\\[\"([^\"]+)\"");
            } catch (e) {}
        }

        if (id == "") {
            out("❌ 未找到网易云歌曲。\n");
            return;
        }
        
        out("✅ 找到歌曲: " + song_name + " - " + artist + " (ID: " + id + ")\n");
        out("[2/2] 正在解析 320k 链接...\n");
        
        string url = "";
        string tmp_res = "";
        string ekey = "";

        // 解析 1：GD
        if (url == "") {
            try {
                tmp_res = get("https://music-api.gdstudio.xyz/api.php?types=url&source=netease&id=" + id + "&br=320") with worker;
                url = json_str(tmp_res, "$.url");
                if (url == "") url = regex(tmp_res, "\"url\":\"([^\"]+)\"");
            } catch (e) {}
        }

        // 解析 2：星海（需查 ekey）
        if (url == "") {
            try {
                tmp_res = get("https://yy.zddyr.top/lx/api/?source=wy&songmid=" + id + "&quality=320k") with worker;
                ekey = json_str(tmp_res, "$.ekey");
                url = json_str(tmp_res, "$.url");
                if (url == "") url = regex(tmp_res, "\"url\":\"([^\"]+)\"");
                if (ekey != "") url = "";
            } catch (e) {}
        }

        // 解析 3：ikun
        if (url == "") {
            try {
                string ikun_body = "{\"source\":\"wy\",\"musicId\":\"" + id + "\",\"quality\":\"320k\"}";
                tmp_res = post("https://c.wwwweb.top/music/url", ikun_body) with worker with header {
                    "Content-Type": "application/json"
                };
                url = json_str(tmp_res, "$.url");
            } catch (e) {}
        }

        // 解析 4：Huibq
        if (url == "") {
            try {
                tmp_res = get("https://lxmusicapi.onrender.com/url/wy/" + id + "/320k") with worker with header {
                    "X-Request-Key": "share-v3",
                    "User-Agent": "lx-music-desktop/2.10.0"
                };
                url = json_str(tmp_res, "$.url");
            } catch (e) {}
        }

        // 解析 5：oiapi
        if (url == "") {
            try {
                tmp_res = get("https://oiapi.net/api/Music_163?id=" + id) with worker;
                url = json_str(tmp_res, "$.data[0].url");
                if (url == "") url = json_str(tmp_res, "$.url");
            } catch (e) {}
        }
        
        if (url != "") {
            url = replace(url, "\\/", "/");
            url = replace(url, "http://", "https://");
            out("✅ 解析成功！\n🔗 链接: " + url + "\n");
            return url with 302 with confirm;
        } else {
            out("❌ 网易云解析失败。\n");
            return;
        }
        
    // ================== QQ 音乐 (qq) ==================
    } else if (cmd == "qq") {
        out("[1/2] 正在搜索 QQ 音乐: " + kw + " ...\n");
        string songmid = "";
        string song_name = "";
        string singer = "";
        string res = "";
        number retry = 3;
        bool success = false;

        // 只使用 vkeys 搜索，带 3 次重试
        while (retry > 0) {
            try {
                res = get("https://api.vkeys.cn/v2/music/tencent?word=" + encoded_kw) with worker with header {
                    "User-Agent": browser_ua
                };
                songmid = regex(res, "\"songmid\"\\s*:\\s*\"([a-zA-Z0-9]+)\"");
                if (songmid == "") songmid = regex(res, "\"id\"\\s*:\\s*\"([a-zA-Z0-9]+)\"");
                if (songmid == "") songmid = regex(res, "\"mid\"\\s*:\\s*\"([a-zA-Z0-9]+)\"");
                song_name = regex(res, "\"song\"\\s*:\\s*\"([^\"]+)\"");
                if (song_name == "") song_name = regex(res, "\"name\"\\s*:\\s*\"([^\"]+)\"");
                singer = regex(res, "\"singer\"\\s*:\\s*\"([^\"]+)\"");
                if (singer == "") singer = regex(res, "\"artist\"\\s*:\\s*\"([^\"]+)\"");
                
                if (songmid != "") {
                    success = true;
                    break;
                }
            } catch (e) {}
            retry--;
            if (retry > 0) sleep(1000);
        }

        if (!success || songmid == "") {
            out("❌ 未找到 QQ 音乐歌曲。\n");
            return;
        }
        
        out("✅ 找到歌曲: " + song_name + " - " + singer + " (songmid: " + songmid + ")\n");
        out("[2/2] 正在解析 320k 链接...\n");
        
        string parse_res = "";
        string url = "";
        number p_retry = 3;
        bool p_success = false;
        
        // 解析带 3 次重试
        while (p_retry > 0) {
            try {
                parse_res = get("https://lxmusicapi.onrender.com/url/tx/" + songmid + "/320k") with worker with header {
                    "X-Request-Key": "share-v3",
                    "User-Agent": "lx-music-desktop/2.10.0"
                };
                url = json_str(parse_res, "$.url");
                string msg = json_str(parse_res, "$.msg");
                
                if (url != "" && !contains(url, "kuwo.cn")) {
                    p_success = true;
                    break;
                } else if (contains(url, "kuwo.cn") || contains(msg, "无法获取")) {
                    url = "";
                }
            } catch (e) {}
            p_retry--;
            if (p_retry > 0) sleep(1000);
        }
        
        if (p_success && url != "") {
            url = replace(url, "\\/", "/");
            url = replace(url, "http://", "https://");
            out("✅ 解析成功！\n🔗 链接: " + url + "\n");
            return url with 302 with confirm;
        } else {
            out("❌ QQ音乐解析失败。\n");
            return;
        }

    // ================== 酷狗音乐 (kg) ==================
    } else if (cmd == "kg") {
        out("[1/2] 正在搜索酷狗音乐: " + kw + " ...\n");
        string hash = "";
        string song_name = "";
        string singer = "";
        string res = "";

        // 源 1：song_search_v2
        try {
            res = get("https://songsearch.kugou.com/song_search_v2?keyword=" + encoded_kw + "&page=1&pagesize=1&platform=WebFilter&userid=-1&clientver=&filter=2&iscorrection=1&privilege_filter=0") with worker with header {
                "User-Agent": browser_ua,
                "Referer": "https://www.kugou.com/"
            };
            hash = regex(res, "\"FileHash\":\"([a-zA-Z0-9]+)\"");
            song_name = regex(res, "\"SongName\":\"([^\"]+)\"");
            singer = regex(res, "\"SingerName\":\"([^\"]+)\"");
        } catch (e) {}

        // 源 2：mobilecdn
        if (hash == "") {
            try {
                res = get("http://mobilecdn.kugou.com/api/v3/search/song?format=json&keyword=" + encoded_kw + "&page=1&pagesize=1&showtype=1") with worker with header {
                    "User-Agent": browser_ua
                };
                hash = regex(res, "\"hash\":\"([a-zA-Z0-9]+)\"");
                song_name = regex(res, "\"songname\":\"([^\"]+)\"");
                singer = regex(res, "\"singername\":\"([^\"]+)\"");
            } catch (e) {}
        }

        if (hash == "") {
            out("❌ 未找到酷狗歌曲。\n");
            return;
        }
        
        out("✅ 找到歌曲: " + song_name + " - " + singer + " (hash: " + hash + ")\n");
        out("[2/2] 正在解析 320k 链接...\n");
        
        string parse_res = "";
        try {
            parse_res = get("https://yy.zddyr.top/lx/api/?source=kg&songmid=" + hash + "&quality=320k") with worker;
        } catch (e) {
            out("❌ 酷狗解析超时。\n");
            return;
        }
        
        string url = regex(parse_res, "\"url\":\"([^\"]+)\"");
        string ekey = regex(parse_res, "\"ekey\":\"([^\"]+)\"");
        
        if (ekey != "") url = "";
        
        if (url != "") {
            url = replace(url, "\\/", "/");
            url = replace(url, "http://", "https://");
            out("✅ 解析成功！\n🔗 链接: " + url + "\n");
            return url with 302 with confirm;
        } else {
            out("❌ 酷狗解析失败。\n");
            return;
        }
        
    // ================== 酷我音乐 (kw) ==================
    } else if (cmd == "kw") {
        out("[1/2] 正在搜索并解析酷我音乐: " + kw + " ...\n");
        string parse_res = "";
        try {
            parse_res = get("https://oiapi.net/api/Kuwo?msg=" + encoded_kw + "&n=1&br=1") with worker;
        } catch (e) {
            out("❌ 酷我解析超时。\n");
            return;
        }
        
        string url = json_str(parse_res, "$.data.url");
        if (url == "") url = json_str(parse_res, "$.data[0].url");
        if (url == "") url = json_str(parse_res, "$.url");
        
        if (url != "") {
            url = replace(url, "\\/", "/");
            url = replace(url, "http://", "https://");
            string song_name = json_str(parse_res, "$.data.song");
            string singer = json_str(parse_res, "$.data.singer");
            out("✅ 找到歌曲: " + song_name + " - " + singer + "\n");
            out("✅ 解析成功！\n🔗 链接: " + url + "\n");
            return url with 302 with confirm;
        } else {
            out("❌ 酷我解析失败。\n");
            return;
        }
        
    } else {
        out("❌ 未知命令: " + cmd + "\n支持: wy, qq, kg, kw\n");
        return;
    }
}
