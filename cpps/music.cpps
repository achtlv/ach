auto main() {
    // ================== 1. 输出欢迎和说明 ==================
    out("========================================\n");
    out("🎵 欢迎使用全平台音乐解析 CLI\n");
    out("支持命令: wy(网易云), qq(QQ音乐), kg(酷狗), kw(酷我)\n");
    out("格式: <平台命令> <完整搜索词>\n");
    out("示例: wy 万能青年旅店\n");
    out("      kw 山海\n");
    out("========================================\n");
    
    // 提示用户输入
    out("请输入命令 > ");

    // ================== 2. 读取用户输入 ==================
    string cmd = "";
    in(cmd);
    
    // 如果用户直接点了“完成”或没输入，则退出
    if (cmd == "") {
        out("\n❌ 未输入任何命令，程序退出。\n");
        return;
    }
    
    // 循环拼接搜索词，保留空格并过滤 EOF
    string kw = "";
    string part = "";
    in(part);
    while (part != "") {
        if (kw == "") kw = part;
        else kw = kw + " " + part;
        
        part = "__EOF__";
        in(part);
        if (part == "__EOF__") break;
    }
    
    if (kw == "") {
        out("\n❌ 未提供搜索词，程序退出。\n");
        return;
    }

    string encoded_kw = urlencode(kw);
    out("\n========================================\n");

    // ================== 3. 开始解析 ==================
    
    // ------------------ 网易云 (wy) ------------------
    if (cmd == "wy") {
        out("[1/3] 正在搜索网易云: " + kw + " ...\n");
        string search_url = "https://music-api.gdstudio.xyz/api.php?types=search&source=netease&name=" + encoded_kw + "&count=1&pages=1";
        string res = "";
        try {
            res = get(search_url) with worker;
        } catch (e) {
            out("❌ 网易云搜索超时或被拦截。\n");
            return;
        }
        
        string id = regex(res, "\"id\":\"([a-zA-Z0-9]+)\"");
        if (id == "") {
            out("❌ 未找到网易云歌曲。\n");
            return;
        }
        string song_name = regex(res, "\"name\":\"([^\"]+)\"");
        string artist = regex(res, "\"artist\":\\[\"([^\"]+)\"");
        out("✅ 找到歌曲: " + song_name + " - " + artist + " (ID: " + id + ")\n");
        
        out("[2/3] 正在并发解析 320k 链接...\n");
        string url1 = "https://music-api.gdstudio.xyz/api.php?types=url&source=netease&id=" + id + "&br=320";
        string url2 = "https://yy.zddyr.top/lx/api/?source=wy&songmid=" + id + "&quality=320k";
        
        deque<string> req_urls;
        req_urls.push_back(url1);
        req_urls.push_back(url2);
        deque<string> responses;
        
        try {
            responses = get_all(req_urls, true);
        } catch (e) {
            out("❌ 网易云解析请求超时。\n");
            return;
        }
        
        if (responses.size() > 0) {
            for (number i = 0; i < responses.size(); i++) {
                string r = responses[i];
                string u = json_str(r, "$.url");
                if (u == "") u = regex(r, "\"url\":\"([^\"]+)\"");
                if (u != "") {
                    u = replace(u, "\\/", "/");
                    u = replace(u, "http://", "https://");
                    out("[3/3] ✅ 解析成功！已弹出确认框，请手动复制或跳转。\n");
                    out("🔗 链接: " + u + "\n");
                    return u with 302 with confirm;
                }
            }
        }
        out("❌ 网易云解析失败：未返回有效链接。\n");
        return;
        
    // ------------------ QQ 音乐 (qq) ------------------
    } else if (cmd == "qq") {
        out("[1/3] 正在搜索 QQ 音乐: " + kw + " ...\n");
        string search_url = "https://c.y.qq.com/soso/fcgi-bin/client_search_cp?w=" + encoded_kw + "&format=json&n=1&p=1&cr=1&aggr=1&flag_qc=0&remoteplace=txt.yqq.song&t=0&g_tk=5381&loginUin=0&hostUin=0&inCharset=utf8&outCharset=utf-8&notice=0&platform=yqq.json&needNewCode=0";
        string res = "";
        try {
            res = get(search_url) with worker;
        } catch (e) {
            out("❌ QQ音乐搜索超时。\n");
            return;
        }
        
        string songmid = regex(res, "\"songmid\":\"([a-zA-Z0-9]+)\"");
        if (songmid == "") {
            out("❌ 未找到 QQ 音乐歌曲。\n");
            return;
        }
        string song_name = regex(res, "\"songname\":\"([^\"]+)\"");
        string singer = regex(res, "\"singername\":\"([^\"]+)\"");
        out("✅ 找到歌曲: " + song_name + " - " + singer + " (songmid: " + songmid + ")\n");
        
        out("[2/3] 正在解析 320k 链接...\n");
        string parse_url = "https://lxmusicapi.onrender.com/url/tx/" + songmid + "/320k";
        string parse_res = "";
        try {
            parse_res = get(parse_url) with worker with header {
                "X-Request-Key": "share-v3",
                "User-Agent": "lx-music-desktop/2.10.0"
            };
        } catch (e) {
            out("❌ QQ音乐解析超时。\n");
            return;
        }
        
        string url = json_str(parse_res, "$.url");
        string msg = json_str(parse_res, "$.msg");
        
        if (contains(url, "kuwo.cn") || contains(msg, "无法获取")) {
            out("❌ QQ音乐解析失败：接口未返回有效链接。(错误信息: " + msg + ")\n");
            return;
        } else if (url != "") {
            url = replace(url, "\\/", "/");
            url = replace(url, "http://", "https://");
            out("[3/3] ✅ 解析成功！已弹出确认框，请手动复制或跳转。\n");
            out("🔗 链接: " + url + "\n");
            return url with 302 with confirm;
        } else {
            out("❌ QQ音乐解析失败：返回数据中未找到 url。\n");
            return;
        }

    // ------------------ 酷狗音乐 (kg) ------------------
    } else if (cmd == "kg") {
        out("[1/3] 正在搜索酷狗音乐: " + kw + " ...\n");
        string search_url = "http://mobilecdn.kugou.com/api/v3/search/song?format=json&keyword=" + encoded_kw + "&page=1&pagesize=1&showtype=1";
        string res = "";
        try {
            res = get(search_url) with worker with header {
                "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
            };
        } catch (e) {
            out("❌ 酷狗搜索超时或被拦截。\n");
            return;
        }
        
        if (status() != 200) {
            out("❌ 酷狗搜索失败，状态码: " + to_str(status()) + "\n");
            return;
        }
        
        string hash = regex(res, "\"hash\":\"([a-zA-Z0-9]+)\"");
        if (hash == "") {
            out("❌ 未找到酷狗歌曲，或接口返回异常。\n");
            return;
        }
        string song_name = regex(res, "\"songname\":\"([^\"]+)\"");
        string singer = regex(res, "\"singername\":\"([^\"]+)\"");
        out("✅ 找到歌曲: " + song_name + " - " + singer + " (hash: " + hash + ")\n");
        
        out("[2/3] 正在解析 320k 链接...\n");
        string parse_url = "https://yy.zddyr.top/lx/api/?source=kg&songmid=" + hash + "&quality=320k";
        string parse_res = "";
        try {
            parse_res = get(parse_url) with worker;
        } catch (e) {
            out("❌ 酷狗解析超时。\n");
            return;
        }
        
        string url = regex(parse_res, "\"url\":\"([^\"]+)\"");
        if (url != "") {
            url = replace(url, "\\/", "/");
            url = replace(url, "http://", "https://");
            out("[3/3] ✅ 解析成功！已弹出确认框，请手动复制或跳转。\n");
            out("🔗 链接: " + url + "\n");
            return url with 302 with confirm;
        } else {
            out("❌ 酷狗解析失败。\n");
            return;
        }
        
    // ------------------ 酷我音乐 (kw) ------------------
    } else if (cmd == "kw") {
        out("[1/2] 正在搜索并解析酷我音乐: " + kw + " ...\n");
        string parse_url = "https://oiapi.net/api/Kuwo?msg=" + encoded_kw + "&n=1&br=1";
        string parse_res = "";
        try {
            parse_res = get(parse_url) with worker;
        } catch (e) {
            out("❌ 酷我解析超时。\n");
            return;
        }
        
        string url = json_str(parse_res, "$.data.url");
        if (url == "") url = json_str(parse_res, "$.data[0].url");
        if (url == "") url = json_str(parse_res, "$.url");
        
        if (url != "") {
            url = replace(url, "\\/", "/");
            url = replace(url, "http://", "https://");
            string song_name = json_str(parse_res, "$.data.song");
            string singer = json_str(parse_res, "$.data.singer");
            out("✅ 找到歌曲: " + song_name + " - " + singer + "\n");
            out("[2/2] ✅ 解析成功！已弹出确认框，请手动复制或跳转。\n");
            out("🔗 链接: " + url + "\n");
            return url with 302 with confirm;
        } else {
            out("❌ 酷我解析失败。\n");
            return;
        }
        
    } else {
        out("❌ 未知命令: " + cmd + "\n支持的命令: wy, qq, kg, kw\n");
        return;
    }
}
